{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "47 Librarian",
  "version": "0.1.0",
  "identifier": "vn.hungtrieu.librarian47",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "47 Librarian",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://cover.localhost cover: http://book.localhost book:; style-src 'self' 'unsafe-inline' blob:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://book.localhost book: blob: data:; frame-src 'self' blob:; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Hung Trieu",
    "copyright": "© 2026 Hung Trieu",
    "category": "Productivity",
    "shortDescription": "Quản lý và đọc kho ebook cá nhân",
    "longDescription": "47 Librarian: quét, tìm, dọn trùng, phân loại và đọc kho ebook (EPUB, MOBI/AZW3, FB2, CBZ/CBR, PDF) trên Windows.",
    "fileAssociations": [
      {
        "ext": [
          "epub",
          "mobi",
          "azw",
          "azw3",
          "fb2",
          "cbz",
          "cbr",
          "pdf",
          "djvu"
        ],
        "name": "47 Librarian ebook",
        "description": "Ebook (47 Librarian)",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "Vietnamese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
